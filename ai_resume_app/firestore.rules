rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /jobs/{jobId} {
      allow read: if signedIn() &&
        (resource.data.status == 'active' ||
          resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /applications/{applicationId} {
      function scoringFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'score',
          'scoreBreakdown',
          'scoringStatus',
          'scoringErrorCode',
          'scoredAt'
        ]);
      }

      allow create: if false;
      allow read: if signedIn() && (
        resource.data.recruiterId == request.auth.uid
      );
      allow update: if signedIn()
        && resource.data.recruiterId == request.auth.uid
        && !scoringFieldsChanged()
        && request.resource.data.recruiterId == resource.data.recruiterId
        && request.resource.data.candidateId == resource.data.candidateId
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.jobTitle == resource.data.jobTitle
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.candidateEmail == resource.data.candidateEmail
        && request.resource.data.candidateName == resource.data.candidateName
        && request.resource.data.resumeFileName == resource.data.resumeFileName
        && request.resource.data.resumeStoragePath == resource.data.resumeStoragePath
        && request.resource.data.appliedAt == resource.data.appliedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'scoreShared',
          'interviewDate',
          'interviewTime',
          'interviewPlatform',
          'meetingLink'
        ])
        && request.resource.data.scoreShared is bool;
      allow delete: if signedIn() && resource.data.recruiterId == request.auth.uid;
    }

    match /candidateApplications/{applicationId} {
      allow read: if signedIn() &&
        resource.data.candidateId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn() &&
        resource.data.recruiterId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'jobId',
          'jobTitle',
          'recruiterId',
          'candidateId',
          'candidateName',
          'resumeFileName',
          'appliedAt',
          'status',
          'scoreShared'
        ]) &&
        request.resource.data.jobId == resource.data.jobId &&
        request.resource.data.recruiterId == resource.data.recruiterId &&
        request.resource.data.candidateId == resource.data.candidateId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'scoreShared'
        ]);
    }

    match /candidateNotifications/{notificationId} {
        allow read: if signedIn() &&
          resource.data.candidateId == request.auth.uid;
        allow create, update, delete: if false;
    }

    match /candidateApplicationScores/{applicationId} {
      allow read: if signedIn() &&
        get(/databases/$(database)/documents/applications/$(applicationId))
          .data.candidateId == request.auth.uid &&
        get(/databases/$(database)/documents/applications/$(applicationId))
          .data.scoreShared == true;
      allow create, update, delete: if false;
    }
  }
}